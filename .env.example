# Copy to .env before production deploy. Do not commit real secrets.

APP_PORT=8080

# PostgreSQL (required in production)
POSTGRES_DB=reconciliation
POSTGRES_USER=recon
POSTGRES_PASSWORD=change-me-in-production

# Neon PostgreSQL (use the pooled connection string for the app):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# App auth
API_KEY=set-a-long-random-api-key
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=set-a-strong-password
SEED_ON_STARTUP=true

# Future live adapters — leave commented until real credentials exist.
# MOJALOOP_BASE_URL=https://fspiop.hub.example
# MOJALOOP_API_KEY=
# MOJALOOP_CLIENT_ID=
# MOJALOOP_CLIENT_SECRET=
