  {
    "type": "response",
    "version": 1,
    "ruleId": 102,
    "priority": 10,
    "description": "GET /settlements/{id} - single settlement lookup. This and GET /settlementWindows are the only GET operations the Mojaloop settlement API defines; GET /settlements and GET /settlementWindows/{id} do not exist (those paths are POST-only).",
    "apiVersion": {
      "minorVersion": 0,
      "majorVersion": 1,
      "type": "settlements",
      "asynchronous": false
    },
    "conditions": {
      "all": [
        {
          "fact": "operationPath",
          "operator": "equal",
          "value": "/settlements/{id}"
        },
        {
          "fact": "method",
          "operator": "equal",
          "value": "get"
        }
      ]
    },
    "event": {
      "method": null,
      "path": null,
      "params": {
        "body": {
          "id": "{$request.params.id}",
