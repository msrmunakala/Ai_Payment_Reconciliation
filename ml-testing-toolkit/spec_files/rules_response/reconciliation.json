[
  {
    "type": "response",
    "version": 1,
    "ruleId": 101,
    "priority": 10,
    "description": "GET /settlementWindows - returns a realistic set of windows with current dates",
    "apiVersion": {
      "minorVersion": 0,
      "majorVersion": 1,
      "type": "settlements",
      "asynchronous": false
    },
    "conditions": {
      "all": [
        {
          "fact": "operationPath",
          "operator": "equal",
          "value": "/settlementWindows"
        },
        {
          "fact": "method",
          "operator": "equal",
          "value": "get"
        }
      ]
    },
    "event": {
      "method": null,
      "path": null,
      "params": {
        "body": [
          {
            "id": 9001,
            "state": "SETTLED",
