# Template for backend/.env. Copy to .env and fill in real values.
# .env is gitignored because it holds a database credential.

# --- Database ---
# PostgreSQL (recommended):
DATABASE_URL=postgresql+psycopg://recon_app:CHANGE_ME@127.0.0.1:5432/reconciliation
# SQLite alternative (used by the unit-test suite; path is relative to the
# process working directory, so start uvicorn from backend/):
# DATABASE_URL=sqlite:///./reconciliation.db

# --- API ---
# The app refuses to start in production while API_KEY is the demo default.
API_KEY=review2-demo-key
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mojaloop Testing Toolkit ---
# Transfers arrive by push on POST /webhooks/transfers (FSPIOP has no bulk
# transfer endpoint). Settlement windows are pulled from the settlement API.
MOJALOOP_ENABLED=true
MOJALOOP_BASE_URL=http://localhost:4040
MOJALOOP_SETTLEMENT_BASE_URL=http://localhost:4040
# "" targets settlements_1.0 (mounted at the root); "v2" targets settlements_2.0.
MOJALOOP_SETTLEMENT_API_PREFIX=
MOJALOOP_TOOLKIT_API_URL=http://localhost:5050
MOJALOOP_FSP_ID=reconciliation-engine

# Enables HMAC-SHA256 verification of inbound webhooks. Leave unset while the
# Testing Toolkit drives the backend: the toolkit does not sign its callbacks.
# WEBHOOK_SECRET=

# --- Scheduling ---
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
SCHEDULER_SYNC_MOJALOOP=true

# --- Seeding ---
# Generates bank statement and ERP ledger rows to reconcile against. Transaction
# data is expected to arrive from the toolkit collection.
SEED_ON_STARTUP=true

# --- Schema ---
# Additive column/table reconciliation at startup. Defaults to SQLite only;
# Alembic owns the schema on a server database.
# AUTO_SCHEMA_SYNC=false
